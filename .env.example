# Optional. Keep credentials on the server.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
PORT=3001
# Runtime SQLite database and image storage (ignored by Git).
DATA_DIR=runtime
# The prototype has no user authentication. Bind locally by default.
HOST=127.0.0.1

# Optional higher-rate USGS key: https://api.waterdata.usgs.gov/signup/
USGS_API_KEY=
# Optional: smaller NASA FIRMS area queries; keyless US regional downloads work without it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Static FEMA NFHL point lookup (no key). Set 0 to use verified local records only.
FEMA_ENABLED=1
# Optional server-side verified exposure JSON; see docs/environment-providers.md.
FLOOD_EXPOSURE_FILE=
# unavailable | demo | recorded. 'recorded' reads genuine live events already in SQLite;
# it does not connect to a licensed network or establish detector completeness.
LIGHTNING_MODE=unavailable
# Isolated tests/offline development can disable background provider polling.
DISABLE_EXTERNAL_PROVIDERS=0
